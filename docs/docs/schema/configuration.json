{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://gremlins.dev/schema/configuration.json",
  "title": "The Gremlins configuration schema",
  "type": "object",
  "properties": {
    "silent": {
      "title": "Silent mode",
      "description": "Suppresses the information output. Error messages stay visible",
      "type": "boolean",
      "default": false
    },
    "unleash": {
      "type": "object",
      "properties": {
        "dry-run": {
          "title": "Dry-run mode",
          "description": "Finds the mutants and reports them without running their tests. The coverage run still runs the tests of the module",
          "type": "boolean",
          "default": false
        },
        "integration": {
          "title": "Integration mode",
          "description": "Runs the complete test suite for each mutant, not only the tests of the mutant's package",
          "type": "boolean",
          "default": false
        },
        "tags": {
          "title": "Tags",
          "description": "The build tags for the Go module to be tested",
          "type": "string",
          "default": "",
          "examples": [
            "tag1,tag2,tag4"
          ]
        },
        "coverpkg": {
          "title": "Cover packages",
          "description": "Apply coverage analysis in each test to packages matching the patterns",
          "type": "string",
          "default": "",
          "examples": [
            "./internal/log,./pkg/..."
          ]
        },
        "diff": {
          "title": "Diff",
          "description": "A Git branch or commit. Gremlins tests only the mutants in the code that changed since the merge base of this reference. Empty tests all the covered mutants",
          "type": "string",
          "default": "",
          "examples": [
            "origin/main"
          ]
        },
        "exclude-files": {
          "title": "Exclude files",
          "description": "Go regular expressions. Gremlins skips each file whose path matches one of them. Gremlins always skips test files",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "examples": [
            [
              "_mock\\.go$",
              "^gen/"
            ]
          ]
        },
        "output": {
          "title": "Output",
          "description": "The output file for machine readable results",
          "type": "string",
          "default": "",
          "examples": [
            "output.json"
          ]
        },
        "output-statuses": {
          "title": "Output statuses",
          "description": "Prints only the mutants with these statuses to the console: l LIVED, c NOT COVERED, t TIMED OUT, m MEMORY ERROR, k KILLED, v NOT VIABLE, s SKIPPED, r RUNNABLE, e EQUIVALENT. Empty prints all. Gremlins ignores an invalid filter with a warning. The JSON output does not change",
          "type": "string",
          "default": "",
          "pattern": "^[lctmkvsre]*$",
          "examples": [
            "lc"
          ]
        },
        "output-diff-statuses": {
          "title": "Output diff statuses",
          "description": "Prints the code diff of the printed mutants with these statuses: l LIVED, k KILLED. Empty prints no diff. Gremlins ignores an invalid filter with a warning",
          "type": "string",
          "default": "",
          "pattern": "^[lk]*$",
          "examples": [
            "l"
          ]
        },
        "workers": {
          "title": "Workers",
          "description": "The number of workers that run mutants in parallel. 0 uses the number of CPUs",
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "examples": [
            4
          ]
        },
        "test-cpu": {
          "title": "Test CPU",
          "description": "The number of CPUs that each test run can use. 0 does not set a limit",
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "examples": [
            1
          ]
        },
        "timeout-coefficient": {
          "title": "Timeout coefficient",
          "description": "The coefficient that multiplies the coverage run time to give the test timeout. 0 uses the default of 5",
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "examples": [
            10
          ]
        },
        "memory-budget": {
          "title": "Memory budget",
          "description": "The memory that all the mutant test runs can use together, as a positive byte count with an optional K, M, G, or T binary unit. An empty value uses the smaller of 1G and half of the available memory",
          "type": "string",
          "default": "",
          "pattern": "^(0*[1-9][0-9]*[KMGT]?)?$",
          "examples": [
            "2G"
          ]
        },
        "threshold": {
          "title": "Thresholds",
          "description": "The thresholds under which Gremlins exits with an error",
          "type": "object",
          "default": {},
          "required": [],
          "properties": {
            "efficacy": {
              "title": "Test efficacy",
              "description": "The test efficacy percentage under which Gremlins exits with an error. 0 disables the check",
              "type": "number",
              "default": 0,
              "minimum": 0,
              "maximum": 100,
              "examples": [
                81.2,
                10
              ]
            },
            "mutant-coverage": {
              "title": "Mutant-coverage",
              "description": "The mutant coverage percentage under which Gremlins exits with an error. 0 disables the check",
              "type": "number",
              "default": 0,
              "minimum": 0,
              "maximum": 100,
              "examples": [
                81.2,
                10
              ]
            }
          }
        }
      }
    },
    "mutants": {
      "title": "Supported mutants",
      "type": "object",
      "properties": {
        "arithmetic-base": {
          "title": "The arithmetic-base Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "conditionals-boundary": {
          "title": "The conditionals-boundary Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "conditionals-negation": {
          "title": "The conditionals-negation Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "increment-decrement": {
          "title": "The increment-decrement Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "invert-negatives": {
          "title": "The invert-negatives Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "invert-loopctrl": {
          "title": "The invert-loopctrl Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        },
        "invert-assignments": {
          "title": "The invert-assignments Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        },
        "invert-bitwise": {
          "title": "The invert-bitwise Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        },
        "invert-bwassign": {
          "title": "The invert-bwassign Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        },
        "invert-logical": {
          "title": "The invert-logical Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        },
        "remove-self-assignments": {
          "title": "The remove-self-assignments Schema",
          "type": "object",
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  }
}
